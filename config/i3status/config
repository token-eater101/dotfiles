# i3status configuration file.
# see "man i3status" for documentation.

general {
        colors = true
        output_format = "i3bar"
        interval = 5
        color_good = "#ffffff"
        color_degraded = "#666666"
        color_bad = "#990000"
}

order += "disk /"
order += "battery all"
order += "memory"
order += "tztime local"
order += "load"


battery all {
        format = " %status %percentage %remaining "
        format_down = " No battery "
        status_chr = "⚡ CHG"
        status_bat = "🔋 BAT"
        status_unk = "? UNK"
        status_full = "☻ FULL"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 10
}

disk "/" {
        format = " 💾 %avail "
}

load {
        format = " ⚙️ %1min "
}

memory {
        format = " 🧠 %available "
        threshold_degraded = "1G"
        format_degraded = " MEMORY LOW: %available "
}

tztime local {
        format = " 📅 %Y-%m-%d  🕒 %H:%M:%S "
}

